# ---------------------------------------------------------------------------
# Sallie — Environment Variables Template
#
# Copy this file to `.env` (or `.env.local`) and fill in real values.
# `.env*` is gitignored except for this template. Never commit real secrets.
# ---------------------------------------------------------------------------

# --- App ---
NODE_ENV=development
EXPO_PUBLIC_API_URL=http://localhost:3000

# --- Sallie Brain (services/brain) ---
BRAIN_HOST=0.0.0.0
BRAIN_PORT=8000
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Knowledge / RAG (services/knowledge) ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=wikipedia
WIKIPEDIA_DUMP_URL=https://dumps.wikimedia.org/enwiki/latest/enwiki-latest-pages-articles.xml.bz2

# --- Optional cloud AI providers (default is fully local via Ollama) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
PERPLEXITY_API_KEY=

# --- Firebase (optional cloud sync) ---
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# --- Android signing (release builds only) ---
KEYSTORE_FILE=
KEYSTORE_PASSWORD=
KEY_ALIAS=
KEY_PASSWORD=
