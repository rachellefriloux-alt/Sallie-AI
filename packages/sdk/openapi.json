    "schemas": {
      "AnswerIn": {
        "properties": {
          "answer": {
            "title": "Answer"
          },
          "question_id": {
            "title": "Question Id",
            "type": "integer"
          }
        },
        "required": [
          "question_id",
          "answer"
        ],
        "title": "AnswerIn",
        "type": "object"
      },
      "CitationOut": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "score": {
            "title": "Score",
            "type": "number"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "score"
