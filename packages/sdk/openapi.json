            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "score"
        ],
        "title": "CitationOut",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "KnowledgeHitOut": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "metadata": {
            "title": "Metadata",
            "type": "object"
          },
          "score": {
            "title": "Score",
            "type": "number"
          },
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "id",
          "score",
          "text",
          "metadata"
        ],
        "title": "KnowledgeHitOut",
        "type": "object"
      },
      "KnowledgeQueryRequest": {
        "properties": {
          "limit": {
            "default": 5,
            "maximum": 50.0,
            "minimum": 1.0,
            "title": "Limit",
            "type": "integer"
          },
          "query": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Query",
            "type": "string"
          }
        },
        "required": [
          "query"
        ],
        "title": "KnowledgeQueryRequest",
        "type": "object"
      },
      "KnowledgeQueryResponse": {
        "properties": {
          "hits": {
            "items": {
              "$ref": "#/components/schemas/KnowledgeHitOut"
            },
            "title": "Hits",
            "type": "array"
          },
          "query": {
            "title": "Query",
            "type": "string"
          },
          "upstream": {
            "title": "Upstream",
            "type": "string"
          }
        },
        "required": [
          "query",
          "upstream",
          "hits"
        ],
        "title": "KnowledgeQueryResponse",
        "type": "object"
      },
      "RespondRequest": {
        "properties": {
          "limit": {
            "default": 4,
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Limit",
            "type": "integer"
          },
          "query": {
            "maxLength": 4000,
            "minLength": 1,
            "title": "Query",
            "type": "string"
          }
        },
        "required": [
          "query"
        ],
        "title": "RespondRequest",
        "type": "object"
      },
      "RespondResponse": {
        "properties": {
          "answer": {
            "title": "Answer",
            "type": "string"
          },
          "citations": {
            "items": {
              "$ref": "#/components/schemas/CitationOut"
            },
            "title": "Citations",
            "type": "array"
          },
          "knowledge_available": {
            "title": "Knowledge Available",
            "type": "boolean"
          },
          "query": {
            "title": "Query",
            "type": "string"
          }
        },
        "required": [
          "query",
          "answer",
          "citations",
          "knowledge_available"
        ],
        "title": "RespondResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
