          "question_id",
          "answer"
        ],
        "title": "AnswerIn",
        "type": "object"
      },
      "CitationOut": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "score": {
            "title": "Score",
            "type": "number"
          },
          "title": {
