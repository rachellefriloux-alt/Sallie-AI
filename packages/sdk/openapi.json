          "metadata"
        ],
        "title": "KnowledgeHitOut",
        "type": "object"
      },
      "KnowledgeQueryRequest": {
        "properties": {
          "limit": {
            "default": 5,
            "maximum": 50.0,
            "minimum": 1.0,
            "title": "Limit",
            "type": "integer"
          },
          "query": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Query",
            "type": "string"
          }
        },
        "required": [
